{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoidFortress Log Event",
  "type": "object",
  "required": [
    "ts",
    "level",
    "phase",
    "msg",
    "pid",
    "boot_id"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_ms": {
      "type": "integer"
    },
    "level": {
      "enum": [
        "DEBUG",
        "INFO",
        "OK",
        "SKIP",
        "WARN",
        "FAIL",
        "FATAL",
        "STATE"
      ]
    },
    "phase": {
      "type": "string"
    },
    "msg": {
      "type": "string"
    },
    "pid": {
      "type": "integer"
    },
    "boot_id": {
      "type": "string"
    },
    "cmd": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "line": {
      "type": "integer"
    },
    "stack": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "mem_total_mb": {
          "type": "integer"
        },
        "mem_avail_mb": {
          "type": "integer"
        },
        "disk_avail_kb": {
          "type": "integer"
        },
        "load_1m": {
          "type": "number"
        },
        "luks_open": {
          "type": "string"
        },
        "mounts_void": {
          "type": "string"
        },
        "uptime_sec": {
          "type": "integer"
        }
      }
    }
  }
}
